# Copy to .env and fill in a real key:
#   cp .env.example .env
#
# Used by scripts/extract.py (OpenRouter vision extraction).
# For here.now proxy, set the same value as an account variable instead
# (see docs/HANDOVER.md) — do not put the key in site/ files.

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Alternate names also accepted by scripts/extract.py:
# OPEN_ROUTER_API_KEY=sk-or-v1-your-key-here
# open-router-api-key=sk-or-v1-your-key-here
